model Computer {
  // Poste informatique gere par un manager. clientId est unique pour garantir
  // qu'un client ne peut etre assigne qu'a un seul poste a la fois.
  id          Int       @id @default(autoincrement())
  name        String
  macAddress  String    @unique
  isBroken    Boolean   @default(false)
  brokenReason String?   @db.Text

  managerId   Int
  manager     Manager   @relation(fields: [managerId], references: [id])

  clientId    Int?      @unique
  client      Client?   @relation(fields: [clientId], references: [id])
  reservations Reservation[]
}
