{% extends "../layout/base.twig" %}

{% block main %}
	<main class="grid min-h-[calc(100vh-4rem)] bg-white lg:grid-cols-2">
		<section class="relative hidden overflow-hidden bg-[#005ac2] p-12 text-white lg:flex lg:flex-col lg:justify-between">
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_18%,rgba(108,248,187,0.24),transparent_28%),linear-gradient(135deg,rgba(0,88,190,0.92),rgba(33,49,69,0.96))]"></div>
			<div class="absolute left-12 right-20 top-32 h-px bg-white/20"></div>
			<div class="absolute bottom-24 right-12 grid grid-cols-3 gap-3 opacity-30">
				<span class="h-10 w-10 rounded border border-white/50"></span>
				<span class="h-10 w-10 rounded border border-white/50"></span>
				<span class="h-10 w-10 rounded border border-white/50"></span>
				<span class="h-10 w-10 rounded border border-white/50"></span>
				<span class="h-10 w-10 rounded border border-white/50 bg-white/20"></span>
				<span class="h-10 w-10 rounded border border-white/50"></span>
			</div>

			<div class="relative z-10 flex items-center gap-3">
				<span class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-lg">
					<img src="/assets/images/favicon.png?v=2" alt="" class="h-full w-full object-contain">
				</span>
				<span class="leading-tight">
					<span class="block text-2xl font-bold">CyberDesk</span>
				</span>
			</div>

			<div class="relative z-10 max-w-lg">
				<p class="mb-3 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-[0.18em] text-white/70">Nouvelle instance</p>
				<h1 class="mb-4 text-4xl font-bold leading-tight tracking-tight">Initialisez votre espace gérant</h1>
				<p class="text-lg leading-7 text-white/80">Enregistrez votre cybercafé et préparez votre tableau de bord pour suivre machines, clients et réservations.</p>
			</div>

			<p class="relative z-10 font-['JetBrains_Mono'] text-xs text-white/55">Systèmes de gestion CyberDesk</p>
		</section>

		<section class="flex items-center justify-center bg-white px-6 py-10 sm:px-10">
			<div class="w-full max-w-md">
				<div class="mb-8 flex items-center justify-center gap-3 text-[#0058be] lg:hidden">
					<span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-lg">
						<img src="/assets/images/favicon.png?v=2" alt="" class="h-full w-full object-contain">
					</span>
					<span class="leading-tight">
						<span class="block text-2xl font-bold">CyberDesk</span>
					</span>
				</div>

				<div class="mb-8 flex rounded-lg bg-[#e5eeff] p-1 font-['JetBrains_Mono'] text-sm font-medium">
					<a href="/login" class="flex-1 rounded py-2 text-center text-[#424754] transition-colors hover:text-[#0b1c30]">Connexion</a>
					<a href="/subscribe" class="flex-1 rounded bg-white py-2 text-center text-[#0b1c30] shadow-sm">Inscription</a>
				</div>

				<div class="mb-8">
					<h2 class="mb-1 text-3xl font-semibold leading-tight tracking-tight text-[#0b1c30]">Initialiser un espace</h2>
					<p class="text-base leading-6 text-[#424754]">Créez l'accès principal de votre cybercafé.</p>
				</div>

				{% if errors.general %}
					<p class="mb-5 rounded-lg border border-[#ffb3ad] bg-[#ffdad7] px-4 py-3 text-sm text-[#930013]">{{ errors.general[0] }}</p>
				{% endif %}

				<form action="/subscribe" method="post" class="space-y-4">
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<div class="space-y-1.5">
							<label for="managerName" class="block font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">Manager</label>
							<input class="w-full rounded-lg border border-[#c2c6d6] bg-white px-3 py-2.5 text-base text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="text" name="managerName" id="managerName" value="{{ old.managerName|default('') }}" placeholder="Jane Doe">
							{% if errors.managerName %}
								<p class="text-sm text-[#ba1a1a]">{{ errors.managerName[0] }}</p>
							{% endif %}
						</div>
						<div class="space-y-1.5">
							<label for="cyberCafeName" class="block font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">Cybercafé</label>
							<input class="w-full rounded-lg border border-[#c2c6d6] bg-white px-3 py-2.5 text-base text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="text" name="cyberCafeName" id="cyberCafeName" value="{{ old.cyberCafeName|default('') }}" placeholder="Nexus Gaming" required>
							{% if errors.cyberCafeName %}
								<p class="text-sm text-[#ba1a1a]">{{ errors.cyberCafeName[0] }}</p>
							{% endif %}
						</div>
					</div>

					<div class="space-y-1.5">
						<label for="siret" class="block font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">SIRET</label>
						<input class="w-full rounded-lg border border-[#c2c6d6] bg-white px-3 py-2.5 font-['JetBrains_Mono'] text-sm tracking-wider text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="text" name="siret" id="siret" value="{{ old.siret|default('') }}" placeholder="12345678900012" inputmode="numeric" pattern="[0-9]{14}" minlength="14" maxlength="14" required>
						{% if errors.siret %}
							<p class="text-sm text-[#ba1a1a]">{{ errors.siret[0] }}</p>
						{% endif %}
					</div>

					<div class="space-y-1.5">
						<label for="password" class="block font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">Mot de passe maître</label>
						<input class="w-full rounded-lg border border-[#c2c6d6] bg-white px-3 py-2.5 text-base text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="password" name="password" id="password" placeholder="••••••••" required>
						<p class="text-xs text-[#424754]">8 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial.</p>
						{% if errors.password %}
							<p class="text-sm text-[#ba1a1a]">{{ errors.password[0] }}</p>
						{% endif %}
					</div>

					<div class="space-y-1.5">
						<label for="confirmPassword" class="block font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">Confirmation</label>
						<input class="w-full rounded-lg border border-[#c2c6d6] bg-white px-3 py-2.5 text-base text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="password" name="confirmPassword" id="confirmPassword" placeholder="••••••••" required>
						{% if errors.confirmPassword %}
							<p class="text-sm text-[#ba1a1a]">{{ errors.confirmPassword[0] }}</p>
						{% endif %}
					</div>

					<button id="subscribe-btn" class="w-full rounded-lg bg-[#0058be] py-3 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-white transition-all hover:bg-[#2170e4] hover:shadow-[inset_0_0_8px_rgba(255,255,255,0.35)] active:scale-[0.98]" type="submit">Provisionner l'espace</button>
				</form>
			</div>
		</section>
	</main>
{% endblock %}
