model Computer {
  id          Int       @id @default(autoincrement())
  name        String
  macAddress  String    @unique
  isBroken    Boolean   @default(false)

  managerId   Int
  manager     Manager   @relation(fields: [managerId], references: [id])

  clientId    Int?      @unique
  client      Client?   @relation(fields: [clientId], references: [id])
}
