model Manager {
  // Proprietaire d'un cybercafe. Un manager possede ses clients, ses postes
  // et toutes les reservations de son etablissement.
  id            Int        @id @default(autoincrement())
  cyberCafeName String
  siret         String     @unique
  password      String
  managerName   String?

  clients       Client[]
  computers     Computer[]
  reservations  Reservation[]
}
