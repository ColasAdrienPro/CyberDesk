model Client {
  // Utilisateur final rattache a un manager. Il peut avoir au plus un poste
  // actuellement assigne et plusieurs reservations dans le temps.
  id          Int       @id @default(autoincrement())
  firstname   String
  lastname    String
  email       String    @unique
  password    String
  age         Int?
  gender      String?

  managerId   Int
  manager     Manager   @relation(fields: [managerId], references: [id])

  computer    Computer?
  reservations Reservation[]
}
