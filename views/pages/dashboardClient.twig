{% extends "../layout/base.twig" %}

{% block main %}
	<main class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-6 px-4 py-5 sm:px-6 sm:py-8">
		{# Entete client et acces rapide a la reservation. #}
		<section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="mb-2 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-[0.18em] text-[#0058be]">Espace client</p>
				<h1 class="text-2xl font-semibold leading-tight text-[#0b1c30] sm:text-3xl">Bonjour {{ client.firstname }} {{ client.lastname }}</h1>
				<p class="mt-2 max-w-2xl text-sm leading-6 text-[#424754] sm:text-base">Bienvenue sur votre dashboard client CyberDesk.</p>
			</div>
			<a href="/reservations-client" class="inline-flex w-fit items-center gap-2 rounded-lg bg-[#0058be] px-4 py-2.5 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-white transition-colors hover:bg-[#2170e4]">
				<span class="material-symbols-outlined text-[18px]">calendar_month</span>
				Reserver
			</a>
		</section>

		{# Resume compte / cybercafe / poste courant. #}
		<section class="grid grid-cols-1 gap-4 md:grid-cols-3">
			<article class="rounded-lg border border-[#c2c6d6] bg-white p-5">
				<div class="flex items-start justify-between gap-4">
					<div class="min-w-0">
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Compte</p>
						<p class="mt-2 truncate text-lg font-semibold text-[#0b1c30]">{{ client.email }}</p>
					</div>
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#e5eeff] text-[#0058be]">
						<span class="material-symbols-outlined text-[24px]">account_circle</span>
					</span>
				</div>
			</article>

			<article class="rounded-lg border border-[#c2c6d6] bg-white p-5">
				<div class="flex items-start justify-between gap-4">
					<div class="min-w-0">
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Cybercafe</p>
						<p class="mt-2 truncate text-lg font-semibold text-[#0b1c30]">{{ manager.cyberCafeName }}</p>
					</div>
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#6cf8bb] text-[#00714d]">
						<span class="material-symbols-outlined text-[24px]">storefront</span>
					</span>
				</div>
			</article>

			<article class="rounded-lg border {% if computer %}{% if computer.isBroken %}border-[#ffb3ad]{% else %}border-[#adc6ff]{% endif %}{% else %}border-[#c2c6d6]{% endif %} bg-white p-5">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Poste</p>
						{% if computer %}
							<p class="mt-2 text-lg font-semibold text-[#0b1c30]">{{ computer.name }}</p>
						{% else %}
							<p class="mt-2 text-lg font-semibold text-[#424754]">Non attribue</p>
						{% endif %}
					</div>
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full {% if computer and computer.isBroken %}bg-[#ffdad7] text-[#930013]{% else %}bg-[#e5eeff] text-[#0058be]{% endif %}">
						<span class="material-symbols-outlined text-[24px]">computer</span>
					</span>
				</div>
			</article>
		</section>

		{# Details de profil et etat du poste assigne. #}
		<section class="grid grid-cols-1 gap-6 lg:grid-cols-3">
			<article class="overflow-hidden rounded-lg border border-[#c2c6d6] bg-white lg:col-span-2">
				<div class="border-b border-[#c2c6d6] bg-[#f8f9ff] px-5 py-4">
					<h2 class="text-xl font-semibold text-[#0b1c30]">Votre session</h2>
					<p class="mt-1 text-sm text-[#424754]">Informations associees a votre compte client.</p>
				</div>

				<div class="grid grid-cols-1 gap-4 p-5 sm:grid-cols-2">
					<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-4">
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Nom complet</p>
						<p class="mt-2 text-base font-semibold text-[#0b1c30]">{{ client.firstname }} {{ client.lastname }}</p>
					</div>
					<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-4">
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Identifiant client</p>
						<p class="mt-2 font-['JetBrains_Mono'] text-base font-semibold text-[#0b1c30]">C-{{ client.id }}</p>
					</div>
					<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-4">
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Age</p>
						<p class="mt-2 text-base font-semibold text-[#0b1c30]">{% if client.age %}{{ client.age }} ans{% else %}Non renseigne{% endif %}</p>
					</div>
					<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-4">
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Genre</p>
						<p class="mt-2 text-base font-semibold text-[#0b1c30]">{% if client.gender %}{{ client.gender }}{% else %}Non renseigne{% endif %}</p>
					</div>
				</div>
			</article>

			<article class="overflow-hidden rounded-lg border border-[#c2c6d6] bg-white">
				<div class="border-b border-[#c2c6d6] bg-[#f8f9ff] px-5 py-4">
					<h2 class="text-xl font-semibold text-[#0b1c30]">Poste attribue</h2>
					<p class="mt-1 text-sm text-[#424754]">Etat du terminal lie a votre compte.</p>
				</div>

				<div class="p-5">
					{% if computer %}
						<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-4">
							<div class="flex items-center justify-between gap-3">
								<p class="font-['JetBrains_Mono'] text-base font-semibold text-[#0b1c30]">{{ computer.name }}</p>
								{% if computer.isBroken %}
									<span class="h-2.5 w-2.5 rounded-full bg-[#ba1a1a]"></span>
								{% else %}
									<span class="h-2.5 w-2.5 rounded-full bg-[#00714d]"></span>
								{% endif %}
							</div>
							<p class="mt-3 truncate font-['JetBrains_Mono'] text-xs font-medium text-[#727785]">{{ computer.macAddress }}</p>
							{% if computer.isBroken %}
								<span class="mt-4 inline-flex w-fit items-center rounded bg-[#ffdad7] px-2 py-1 font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider text-[#ba1a1a]">En panne</span>
								{% if computer.brokenReason %}
									<div class="mt-4 rounded-lg border border-[#ffb3ad] bg-white px-3 py-2.5">
										<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#930013]">Raison signalee</p>
										<p class="mt-2 text-sm leading-6 text-[#424754]">{{ computer.brokenReason }}</p>
									</div>
								{% endif %}
							{% else %}
								<span class="mt-4 inline-flex w-fit items-center rounded bg-[#ecfdf5] px-2 py-1 font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider text-[#047857]">Fonctionnel</span>
								<form action="/dashboardClient/computer/report-broken" method="post" class="mt-4 space-y-3">
									{# Le signalement passe par clientRouter.js et marque le poste en panne. #}
									<div class="space-y-1.5">
										<label for="brokenReason" class="block font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Raison de la panne</label>
										<textarea id="brokenReason" name="brokenReason" rows="4" maxlength="500" required class="w-full resize-none rounded-lg border border-[#c2c6d6] bg-white px-3 py-2.5 text-sm leading-6 text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" placeholder="Ex. ecran noir, clavier HS, ordinateur qui ne demarre plus...">{{ reportOld.brokenReason|default('') }}</textarea>
										{% if reportError %}
											<p class="text-sm text-[#ba1a1a]">{{ reportError }}</p>
										{% endif %}
									</div>
									<button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-[#ffb3ad] bg-white px-3 py-2.5 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#930013] transition-colors hover:bg-[#ffdad7]" onclick="return confirm('Declarer cet ordinateur en panne ?');">
										<span class="material-symbols-outlined text-[18px]">report</span>
										Declarer en panne
									</button>
								</form>
							{% endif %}
						</div>
					{% else %}
						<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-5 text-sm leading-6 text-[#424754]">
							Aucun poste n'est actuellement attribue a votre compte.
						</div>
					{% endif %}
				</div>
			</article>
		</section>
	</main>
{% endblock %}
