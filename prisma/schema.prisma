// Point d'entree Prisma. Les modeles sont repartis dans plusieurs fichiers
// du dossier prisma/, car prisma.config.js indique `schema: "prisma/"`.

// Genere le client JavaScript importe depuis @prisma/client.
generator client {
  provider = "prisma-client-js"
}

// Base MySQL/MariaDB. L'URL complete est fournie par prisma.config.js.
datasource db {
  provider = "mysql"
}
