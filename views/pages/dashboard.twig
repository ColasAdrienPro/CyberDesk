{% extends "../layout/base.twig" %}

{% block main %}
	<main class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 px-4 py-5 sm:px-6 sm:py-8">
		<section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="mb-2 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-[0.18em] text-[#0058be]">Console d'administration</p>
				<h1 class="text-2xl font-semibold leading-tight text-[#0b1c30] sm:text-3xl">Tableau de bord</h1>
				<p class="mt-2 max-w-2xl text-sm leading-6 text-[#424754] sm:text-base">Vue d'ensemble de
					{{ manager.cyberCafeName }}
					: parc, clients et état des postes.</p>
			</div>

		</section>

		<section class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
			<article class="group rounded-lg border border-[#c2c6d6] bg-white p-5">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Total ordinateurs</p>
						<p class="mt-2 text-3xl font-semibold text-[#0b1c30]">{{ dashboardStats.totalComputers|default(0) }}</p>
					</div>
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#e5eeff] text-[#0058be] transition-transform group-hover:scale-110">
						<span class="material-symbols-outlined text-[24px]">computer</span>
					</span>
				</div>
			</article>

			<article class="group rounded-lg border border-[#c2c6d6] bg-white p-5">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Sessions actives</p>
						<p class="mt-2 text-3xl font-semibold text-[#0058be]">{{ dashboardStats.activeSessions|default(0) }}</p>
					</div>
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#d8e2ff] text-[#0058be] transition-transform group-hover:scale-110">
						<span class="material-symbols-outlined text-[24px]">timer</span>
					</span>
				</div>
			</article>

			<article class="group rounded-lg border border-[#c2c6d6] bg-white p-5">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Clients</p>
						<p class="mt-2 text-3xl font-semibold text-[#00714d]">{{ dashboardStats.totalClients|default(0) }}</p>
					</div>
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#6cf8bb] text-[#00714d] transition-transform group-hover:scale-110">
						<span class="material-symbols-outlined text-[24px]">group</span>
					</span>
				</div>
			</article>

			<article class="group rounded-lg border border-[#ffb3ad] bg-white p-5">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#ba1a1a]">Hors service</p>
						<p class="mt-2 text-3xl font-semibold text-[#ba1a1a]">{{ dashboardStats.brokenComputers|default(0) }}</p>
					</div>
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#ffdad7] text-[#930013] transition-transform group-hover:scale-110">
						<span class="material-symbols-outlined text-[24px]">warning</span>
					</span>
				</div>
			</article>
		</section>

		<section class="grid grid-cols-1 gap-6 lg:grid-cols-3">
			<article class="overflow-hidden rounded-lg border border-[#c2c6d6] bg-white lg:col-span-2">
				<div class="flex items-center justify-between gap-3 border-b border-[#c2c6d6] bg-[#f8f9ff] px-5 py-4">
					<div>
						<h2 class="text-xl font-semibold text-[#0b1c30]">Parc informatique</h2>
						<p class="mt-1 text-sm text-[#424754]">État opérationnel des terminaux enregistrés.</p>
					</div>
					<a href="/computerboard" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#0058be] transition-colors hover:bg-[#e5eeff]">
						<span class="material-symbols-outlined text-[18px]">open_in_new</span>
						Voir tout
					</a>
				</div>

				{% if computers and computers|length > 0 %}
					<div class="grid grid-cols-1 gap-3 p-4 sm:grid-cols-2 xl:grid-cols-3">
						{% for computer in computers|slice(0, 9) %}
							<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-3 transition-colors hover:border-[#adc6ff]">
								<div class="flex items-center justify-between gap-3">
									<p class="truncate font-['JetBrains_Mono'] text-sm font-semibold text-[#0b1c30]">{{ computer.name }}</p>
									{% if computer.isBroken %}
										<span class="h-2 w-2 shrink-0 rounded-full bg-[#ba1a1a]"></span>
									{% elseif computer.client %}
										<span class="h-2 w-2 shrink-0 rounded-full bg-[#0058be]"></span>
									{% else %}
										<span class="h-2 w-2 shrink-0 rounded-full bg-[#00714d]"></span>
									{% endif %}
								</div>
								<p class="mt-2 truncate font-['JetBrains_Mono'] text-xs font-medium text-[#727785]">{{ computer.macAddress }}</p>

								{% if computer.isBroken %}
									<span class="mt-3 inline-flex w-fit items-center rounded bg-[#ffdad7] px-2 py-1 font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-wider text-[#ba1a1a]">En panne</span>
								{% elseif computer.client %}
									<span class="mt-3 inline-flex max-w-full items-center gap-1 rounded bg-[#eaf1ff] px-2 py-1 font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-wider text-[#0058be]" title="Occupé par {{ computer.client.firstname }} {{ computer.client.lastname }}">
										<span class="shrink-0">Occupé par</span>
										<span class="truncate">{{ computer.client.firstname }} {{ computer.client.lastname }}</span>
									</span>
								{% else %}
									<span class="mt-3 inline-flex w-fit items-center rounded bg-[#ecfdf5] px-2 py-1 font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-wider text-[#047857]">Disponible</span>
								{% endif %}
							</div>
						{% endfor %}
					</div>
				{% else %}
					<div class="flex flex-col items-center justify-center px-6 py-14 text-center">
						<span class="material-symbols-outlined mb-3 text-[42px] text-[#727785]">computer</span>
						<h3 class="text-lg font-semibold text-[#0b1c30]">Aucun ordinateur enregistré</h3>
						<p class="mt-2 max-w-md text-sm leading-6 text-[#424754]">Ajoutez des terminaux pour alimenter votre tableau de bord.</p>
						<a href="/computerboard" class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-[#0058be] px-4 py-2.5 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-white transition-all hover:bg-[#2170e4]">
							<span class="material-symbols-outlined text-[20px]">add</span>
							Ajouter un ordinateur
						</a>
					</div>
				{% endif %}
			</article>

			<div class="flex flex-col gap-6">
				<article class="overflow-hidden rounded-lg border border-[#c2c6d6] bg-white">
					<div class="border-b border-[#c2c6d6] bg-[#f8f9ff] px-4 py-3">
						<h2 class="flex items-center gap-2 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">
							<span class="material-symbols-outlined text-[20px] text-[#ba1a1a]">warning</span>
							Pannes signalées
						</h2>
					</div>

					<div class="flex flex-col gap-3 p-4">
						{% if brokenComputers and brokenComputers|length > 0 %}
							{% for computer in brokenComputers|slice(0, 3) %}
								<div class="flex items-start gap-3 rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-3">
									<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#ffdad7] text-[#ba1a1a]">
										<span class="material-symbols-outlined text-[16px]">hardware</span>
									</span>
									<div class="min-w-0">
										<p class="truncate text-sm font-medium text-[#0b1c30]">{{ computer.name }}</p>
										<p class="mt-1 font-['JetBrains_Mono'] text-xs font-medium text-[#727785]">Maintenance requise</p>
										{% if computer.brokenReason %}
											<p class="mt-2 text-sm leading-5 text-[#424754]">{{ computer.brokenReason }}</p>
										{% endif %}
										<form action="/computer/{{ computer.id }}/repair" method="post" class="mt-3">
											<input type="hidden" name="redirectTo" value="/dashboard">
											<button type="submit" class="inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-[#c2c6d6] bg-white px-3 py-2 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#00714d] transition-colors hover:border-[#6cf8bb] hover:bg-[#ecfdf5]" onclick="return confirm('Marquer cette panne comme corrigee ?');">
												<span class="material-symbols-outlined text-[18px]">task_alt</span>
												Panne corrigee
											</button>
										</form>
									</div>
								</div>
							{% endfor %}
						{% else %}
							<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-4 text-sm text-[#424754]">
								Aucun incident matériel signalé.
							</div>
						{% endif %}
					</div>
				</article>

				<article class="overflow-hidden rounded-lg border border-[#c2c6d6] bg-white">
					<div class="flex items-center justify-between border-b border-[#c2c6d6] bg-[#f8f9ff] px-4 py-3">
						<h2 class="flex items-center gap-2 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">
							<span class="material-symbols-outlined text-[20px] text-[#0058be]">group</span>
							Clients récents
						</h2>
						<a href="/clientboard" class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#0058be] hover:text-[#2170e4]">Voir</a>
					</div>

					{% if recentClients and recentClients|length > 0 %}
						<div class="overflow-x-auto">
							<table class="w-full border-collapse text-left">
								<thead>
									<tr class="border-b border-[#c2c6d6] bg-[#f8f9ff]">
										<th class="px-4 py-2 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Nom</th>
										<th class="px-4 py-2 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Email</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-[#c2c6d6]">
									{% for client in recentClients %}
										<tr class="hover:bg-[#e5eeff]/50">
											<td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-[#0b1c30]">{{ client.firstname }}
												{{ client.lastname }}</td>
											<td class="max-w-40 truncate px-4 py-3 text-sm text-[#424754]">{{ client.email }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<div class="p-4">
							<div class="rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] p-4 text-sm text-[#424754]">
								Aucun client enregistré pour le moment.
							</div>
						</div>
					{% endif %}
				</article>
			</div>
		</section>
	</main>
{% endblock %}
