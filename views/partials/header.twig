<header class="sticky top-0 z-40 flex min-h-16 w-full items-center justify-between gap-4 border-b border-[#c2c6d6] bg-[#f8f9ff]/95 px-4 py-3 text-[#0b1c30] backdrop-blur sm:px-6">
	<a href="{% if isLogged %}/dashboard{% else %}/login{% endif %}" class="flex shrink-0 items-center gap-3">
		<span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-lg">
			<img src="/assets/images/favicon.png?v=2" alt="" class="h-full w-full object-contain">
		</span>
		<span class="leading-tight">
			<span class="block text-base font-bold text-[#0058be] sm:text-lg">CyberDesk</span>
		</span>
	</a>

	<ul class="flex flex-wrap items-center justify-end gap-2 font-['JetBrains_Mono'] text-xs font-medium sm:text-sm">
		{% if isLogged %}
			<li>
				<a href="/dashboard" class="flex items-center gap-2 rounded-lg px-3 py-2 transition-colors {% if currentPath == '/dashboard' %}bg-[#6cf8bb] text-[#00714d]{% else %}text-[#424754] hover:bg-[#e5eeff] hover:text-[#0b1c30]{% endif %}">
					<span class="material-symbols-outlined hidden text-[18px] sm:inline">dashboard</span>
					Accueil
				</a>
			</li>
			<li>
				<a href="/computerboard" class="flex items-center gap-2 rounded-lg px-3 py-2 transition-colors {% if currentPath == '/computerboard' %}bg-[#6cf8bb] text-[#00714d]{% else %}text-[#424754] hover:bg-[#e5eeff] hover:text-[#0b1c30]{% endif %}">
					<span class="material-symbols-outlined hidden text-[18px] sm:inline">computer</span>
					Ordinateurs
				</a>
			</li>
			<li>
				<a href="/clientboard" class="flex items-center gap-2 rounded-lg px-3 py-2 transition-colors {% if currentPath == '/clientboard' %}bg-[#6cf8bb] text-[#00714d]{% else %}text-[#424754] hover:bg-[#e5eeff] hover:text-[#0b1c30]{% endif %}">
					<span class="material-symbols-outlined hidden text-[18px] sm:inline">groups</span>
					Clients
				</a>
			</li>
			<li>
				<a href="/logout" class="flex items-center gap-2 rounded-lg border border-[#c2c6d6] bg-white px-3 py-2 text-[#424754] transition-colors hover:border-[#adc6ff] hover:text-[#0058be]">
					<span class="material-symbols-outlined hidden text-[18px] sm:inline">logout</span>
					Déconnexion
				</a>
			</li>
		{% else %}
			<li>
				<a href="/login" class="rounded-lg px-3 py-2 transition-colors {% if currentPath == '/login' %}bg-white text-[#0b1c30] shadow-sm{% else %}text-[#424754] hover:bg-[#e5eeff] hover:text-[#0b1c30]{% endif %}">Connexion</a>
			</li>
			<li>
				<a href="/subscribe" class="rounded-lg px-4 py-2 shadow-sm transition-colors {% if currentPath == '/subscribe' %}bg-[#0058be] text-white{% else %}bg-white text-[#0058be] hover:bg-[#d8e2ff]{% endif %}">Inscription</a>
			</li>
		{% endif %}
	</ul>
</header>
