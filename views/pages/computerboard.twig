{% extends "../layout/base.twig" %}

{% block main %}
	<main class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-5 px-4 py-5 sm:gap-6 sm:px-6 sm:py-8">
		<section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="mb-2 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-[0.18em] text-[#0058be]">Parc informatique</p>
				<h1 class="text-2xl font-semibold leading-tight text-[#0b1c30] sm:text-3xl">Inventaire des terminaux</h1>
				<p class="mt-2 max-w-2xl text-sm leading-6 text-[#424754] sm:text-base">Gérez et surveillez les postes rattachés à votre espace CyberDesk.</p>
			</div>

			<button id="open-computer-modal" type="button" class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-transparent bg-[#0058be] px-4 py-2.5 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-white shadow-sm transition-all hover:bg-[#2170e4] hover:shadow-[inset_0_0_8px_rgba(255,255,255,0.35)] active:scale-[0.98] sm:w-auto">
				<span class="material-symbols-outlined text-[20px]">add</span>
				Ajouter un ordinateur
			</button>
		</section>

		<section class="grid grid-cols-1 gap-3 sm:grid-cols-3">
			<article class="rounded-lg border border-[#c2c6d6] bg-white p-4">
				<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Terminaux</p>
				<p class="mt-2 text-3xl font-semibold text-[#0b1c30]">{{ computers|length|default(0) }}</p>
			</article>
			<article class="rounded-lg border border-[#c2c6d6] bg-white p-4">
				<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Disponibles</p>
				<p class="mt-2 text-3xl font-semibold text-[#00714d]">
					{{ availableComputers|default(0) }}
				</p>
			</article>
			<article class="rounded-lg border border-[#c2c6d6] bg-white p-4">
				<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Occupés</p>
				<p class="mt-2 text-3xl font-semibold text-[#0058be]">{{ occupiedComputers|default(0) }}</p>
			</article>
		</section>

		<section class="flex flex-col gap-4 rounded-lg border border-[#c2c6d6] bg-white p-4 lg:flex-row lg:items-center">
			<div class="relative w-full lg:w-96">
				<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-[#727785]">search</span>
				<input class="w-full rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] py-2.5 pl-10 pr-4 text-sm text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="search" placeholder="Rechercher un terminal...">
			</div>

			<div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:w-auto">
				<select class="w-full rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] px-3 py-2.5 text-sm text-[#0b1c30] transition-all focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]">
					<option>Tous les statuts</option>
					<option>Disponible</option>
					<option>Occupé</option>
				</select>
				<select class="w-full rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] px-3 py-2.5 text-sm text-[#0b1c30] transition-all focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]">
					<option>Tri par création</option>
					<option>Nom du terminal</option>
					<option>Adresse MAC</option>
				</select>
			</div>

			<p class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#424754] lg:ml-auto">{{ computers|length|default(0) }}
				ordinateur
				{% if computers|length != 1 %}s
				{% endif %}
			</p>
		</section>

		<section class="overflow-hidden rounded-lg border border-[#c2c6d6] bg-white">
			{% if computers and computers|length > 0 %}
				<div class="grid grid-cols-1 gap-4 p-4 md:grid-cols-2 xl:grid-cols-3">
					{% for computer in computers %}
						<article class="group flex min-h-64 flex-col overflow-hidden rounded-lg border border-[#c2c6d6] bg-white transition-colors hover:border-[#adc6ff] {% if computer.client %}shadow-[inset_0_2px_0_#2170e4]{% endif %}">
							<div class="flex items-center justify-between gap-3 border-b border-[#c2c6d6] bg-[#f8f9ff] px-4 py-3">
								<div class="flex min-w-0 items-center gap-2">
									<span class="material-symbols-outlined shrink-0 text-[22px] {% if computer.client %}text-[#0058be]{% else %}text-[#727785]{% endif %}">desktop_windows</span>
									<h2 class="truncate font-['JetBrains_Mono'] text-sm font-semibold text-[#0b1c30]">{{ computer.name }}</h2>
								</div>

								{% if computer.client %}
									<span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#eaf1ff] px-2.5 py-1 font-['JetBrains_Mono'] text-xs font-medium text-[#0058be]">
										<span class="h-1.5 w-1.5 rounded-full bg-[#0058be]"></span>
										Occupé
									</span>
								{% else %}
									<span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#ecfdf5] px-2.5 py-1 font-['JetBrains_Mono'] text-xs font-medium text-[#047857]">
										<span class="h-1.5 w-1.5 rounded-full bg-[#059669]"></span>
										Disponible
									</span>
								{% endif %}
							</div>

							<div class="flex flex-1 flex-col gap-4 p-4">
								<div>
									<p class="mb-1 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Adresse MAC</p>
									<p class="break-all font-['JetBrains_Mono'] text-sm font-medium text-[#0b1c30]">{{ computer.macAddress }}</p>
								</div>

								<div>
									<p class="mb-1 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Identifiant</p>
									<p class="font-['JetBrains_Mono'] text-sm font-medium text-[#424754]">TERM-{{ computer.id }}</p>
								</div>

								<div class="mt-auto rounded-lg border border-[#c2c6d6] bg-[#f8f9ff] px-3 py-2">
									<p class="mb-1 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">Utilisateur actuel</p>
									{% if computer.client %}
										<div class="flex items-center gap-2">
											<span class="flex h-7 w-7 items-center justify-center rounded bg-[#2170e4] font-['JetBrains_Mono'] text-xs font-bold text-white">
												{{ computer.client.firstname|first|upper }}{{ computer.client.lastname|first|upper }}
											</span>
											<p class="truncate text-sm font-medium text-[#0b1c30]">{{ computer.client.firstname }}
												{{ computer.client.lastname }}</p>
										</div>
									{% else %}
										<p class="text-sm italic text-[#424754]">Aucun client assigné</p>
									{% endif %}
								</div>
							</div>
						</article>
					{% endfor %}
				</div>

				<div class="flex flex-col gap-1 border-t border-[#c2c6d6] bg-[#f8f9ff] px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
					<p class="text-sm text-[#424754]">Affichage de
						{{ computers|length }}
						ordinateur
						{% if computers|length != 1 %}s
						{% endif %}
					</p>
					<span class="font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#727785]">CyberDesk</span>
				</div>
			{% else %}
				<div class="flex flex-col items-center justify-center px-6 py-16 text-center">
					<span class="material-symbols-outlined mb-3 text-[44px] text-[#727785]">desktop_windows</span>
					<h2 class="text-xl font-semibold text-[#0b1c30]">Aucun ordinateur enregistré</h2>
					<p class="mt-2 max-w-md text-sm leading-6 text-[#424754]">Ajoutez votre premier terminal pour commencer à construire votre parc informatique.</p>
					<button type="button" class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-[#0058be] px-4 py-2.5 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-white transition-all hover:bg-[#2170e4]" data-open-computer-modal>
						<span class="material-symbols-outlined text-[20px]">add</span>
						Ajouter un ordinateur
					</button>
				</div>
			{% endif %}
		</section>
	</main>

	<dialog id="computer-modal" class="m-auto max-h-[92vh] w-[min(94vw,640px)] overflow-y-auto rounded-lg border border-[#c2c6d6] bg-white p-0 text-[#0b1c30] shadow-[0_18px_50px_rgba(11,28,48,0.18)] backdrop:bg-[#0b1c30]/40" {% if errors %} data-open-on-load="true" {% endif %}>
		<div class="flex items-center justify-between gap-4 border-b border-[#c2c6d6] bg-[#f8f9ff] px-5 py-4">
			<div>
				<h2 class="text-xl font-semibold leading-tight">Ajouter un ordinateur</h2>
				<p class="mt-1 text-sm text-[#424754]">Enregistrez un nouveau terminal dans votre parc.</p>
			</div>
			<button type="button" class="rounded p-1.5 text-[#424754] transition-colors hover:bg-[#e5eeff] hover:text-[#0b1c30]" data-close-computer-modal aria-label="Fermer">
				<span class="material-symbols-outlined text-[22px]">close</span>
			</button>
		</div>

		<form action="/computerboard" method="post" class="space-y-4 px-4 py-5 sm:px-5">
			{% if errors.general %}
				<div class="rounded-lg border border-[#ffb3ad] bg-[#ffdad7] px-4 py-3 text-sm text-[#930013]">
					{% for error in errors.general %}
						<p>{{ error }}</p>
					{% endfor %}
				</div>
			{% endif %}

			<div class="space-y-1.5">
				<label for="name" class="block font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">Nom du poste</label>
				<input class="w-full rounded-lg border border-[#c2c6d6] bg-white px-3 py-2.5 text-base text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="text" id="name" name="name" value="{{ old.name|default('') }}" placeholder="Ex. TERM-01">
				{% if errors.name %}
					<p class="text-sm text-[#ba1a1a]">{{ errors.name[0] }}</p>
				{% endif %}
			</div>

			<div class="space-y-1.5">
				<label for="macAddress" class="block font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#0b1c30]">Adresse MAC</label>
				<div class="relative">
					<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-[#727785]">memory</span>
					<input class="w-full rounded-lg border border-[#c2c6d6] bg-white py-2.5 pl-10 pr-3 font-['JetBrains_Mono'] text-sm font-medium uppercase tracking-[0.18em] text-[#0b1c30] transition-all placeholder:text-[#727785] focus:border-[#0058be] focus:outline-none focus:shadow-[0_0_0_3px_rgba(0,88,190,0.10)]" type="text" id="macAddress" name="macAddress" value="{{ old.macAddress|default('') }}" placeholder="00:00:00:00:00:00" maxlength="17">
				</div>
				<p class="text-sm text-[#424754]">Format attendu : XX:XX:XX:XX:XX:XX.</p>
				{% if errors.macAddress %}
					<p class="text-sm text-[#ba1a1a]">{{ errors.macAddress[0] }}</p>
				{% endif %}
			</div>

			<div class="flex flex-col-reverse gap-3 border-t border-[#c2c6d6] pt-4 sm:flex-row sm:justify-end">
				<button type="button" class="rounded-lg border border-[#c2c6d6] bg-white px-4 py-2.5 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-[#424754] transition-colors hover:border-[#adc6ff] hover:text-[#0058be]" data-close-computer-modal>Annuler</button>
				<button type="submit" class="rounded-lg bg-[#0058be] px-4 py-2.5 font-['JetBrains_Mono'] text-sm font-medium tracking-[0.05em] text-white transition-all hover:bg-[#2170e4] hover:shadow-[inset_0_0_8px_rgba(255,255,255,0.35)] active:scale-[0.98]">Enregistrer</button>
			</div>
		</form>
	</dialog>

	<script src="/assets/js/computerboard.js" defer></script>
{% endblock %}
